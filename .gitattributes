# 改行の統一 (M91 追補 sub-12)。作業ツリーの改行を core.autocrlf などマシンの設定に依存させない。
# 順序は「既定 -> 例外 (CRLF) -> バイナリ」で、後の行が勝つ。
# テキスト判定は git の自動判定に任せ、テキストは作業ツリーでも LF にする。
* text=auto eol=lf

# cmd.exe と Visual Studio / MSBuild が書き戻す形式は CRLF が正。
# LF にすると VS で保存するたびに全行が差分に見える。blob は LF のまま、checkout 時だけ変換する。
*.cmd text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.csproj text eol=crlf
*.rc text eol=crlf

# golden スクリーンショット (M52c) を含む PNG は絶対に改行変換させない。
# 現状 git の自動判定でも binary 扱いになるが、判定に任せると 1 バイトの取り違えが
# 「ピクセル回帰テストが理由不明で赤い」という最悪の形で出るので明示する。
*.png binary

# Deep-Modal (M76) のボクセルキャッシュ。フィールド単位で書く POD だが改行変換で
# 中身が壊れると「.mvox が読めない」が理由不明で出るので明示する (golden PNG と同じ理由)
*.mvox binary

# Deep-Modal (M76d) の学習済みネット (.dmnet) と fixture のバイナリ期待値。
# 改行変換で 1 バイトでも動くと「fixture が理由不明で不一致」になる (.mvox と同じ理由)
*.dmnet binary
tests/deepmodal/*.bin binary

# ModalSoundLibrary のクックキャッシュ (.msfm、.mcvx と同型)。cache\ (gitignore) にしか
# 生まれず今日の版管理対象は無いが、spec §4.2 の宣言どおり明示しておく (sub-10 F。
# 将来 prebaked cache を配布する等で状況が変わったときに、改行変換で静かに壊れるのを防ぐ)
*.msfm binary

# bat は cmd.exe の都合で**ディスク上 CRLF が必須** (LF だと行を途中で切られ、CP932 では
# 日本語 rem コメントの断片がコマンド実行される — net_verify で実際に踏んだ)。
# blob は LF のまま、checkout 時の変換だけを強制する。autocrlf の個人設定に依存させない。
*.bat text eol=crlf

# GameLift Server SDK / OpenSSL (M81g): ビルド済みバイナリとパッチは改行変換させない
# (パッチが CRLF 化すると git apply が通らず、SDK の再ビルド手順 BUILD.md が壊れる)
external/gamelift-server-sdk/lib/**/*.lib binary
external/gamelift-server-sdk/patches/*.patch -text
external/openssl/redist/*.dll binary
external/openssl/lib/*.lib binary

# golden・replay・アセットのバイナリ。自動判定に任せず 1 バイトも変換させない。
# まだリポジトリに無い種類 (.rep など) も、生成されてコミットされうるので先に書く。
*.fbx binary
*.glb binary
*.wav binary
*.dds binary
*.blend binary
*.lib binary
*.dll binary
*.exe binary
*.pdf binary
*.pyc binary
*.rep binary
