{"jsonrpc":"2.0","id":40,"method":"tools/call","params":{"name":"note_read","arguments":{"latest":3}}}
{"jsonrpc":"2.0","id":41,"method":"tools/call","params":{"name":"note_read","arguments":{"topic":"m87-state","latest":0}}}
{"jsonrpc":"2.0","id":42,"method":"tools/call","params":{"name":"note_read","arguments":{"topic":"m87-state","latest":51}}}
