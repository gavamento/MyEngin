<?xml version="1.0" encoding="utf-8"?>
<!--
  libvterm 0.3.3 (external\libvterm、改変なし) の静的ライブラリ。統合ターミナル (M106) の VT 解釈に使う。
  手書き (tools\gen_project_files.ps1 の対象外)。ソースを足し引きするときはこのファイルを直接直す。
  - C としてコンパイルする (libvterm は C99。MSVC の /std:c11 で受ける)。
  - 第三者コードなので警告は Level3 + TreatWarningAsError=false (Engine.vcxproj の external と同じ扱い)。
  - /fp:precise・CRT (/MT, /MTd) は Common.props のまま (全プロジェクト一致の契約)。
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{1120A41F-3F5C-4370-A92C-4C3909DCFC62}</ProjectGuid>
    <RootNamespace>libvterm</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="Common.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <CompileAs>CompileAsC</CompileAs>
      <LanguageStandard_C>stdc11</LanguageStandard_C>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <AdditionalIncludeDirectories>$(RepoRoot)external\libvterm\include;$(RepoRoot)external\libvterm\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\external\libvterm\src\encoding.c" />
    <ClCompile Include="..\external\libvterm\src\keyboard.c" />
    <ClCompile Include="..\external\libvterm\src\mouse.c" />
    <ClCompile Include="..\external\libvterm\src\parser.c" />
    <ClCompile Include="..\external\libvterm\src\pen.c" />
    <ClCompile Include="..\external\libvterm\src\screen.c" />
    <ClCompile Include="..\external\libvterm\src\state.c" />
    <ClCompile Include="..\external\libvterm\src\unicode.c" />
    <ClCompile Include="..\external\libvterm\src\vterm.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\external\libvterm\include\vterm.h" />
    <ClInclude Include="..\external\libvterm\include\vterm_keycodes.h" />
    <ClInclude Include="..\external\libvterm\src\rect.h" />
    <ClInclude Include="..\external\libvterm\src\utf8.h" />
    <ClInclude Include="..\external\libvterm\src\vterm_internal.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
