<?xml version="1.0" encoding="utf-8"?>
<!--
  GameLogic.dll — ホットリロード対象 (engine_spec.md 8.4)。
  重要な制約:
    - Engine.lib をリンクしない。src\Shared\ の C ABI ヘッダのみに依存する
    - インクリメンタルリンク無効 (.ilk ロック/破損回避)
    - /PDBALTPATH で PDB 参照を相対名にし、コピー先 (cache\hot\v{N}\) の PDB を
      デバッガがロードできるようにする → ブレークポイント維持 & ファイルロック回避
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{B2C3D4E5-3333-4B6C-9D8E-0F1A2B3C4D5E}</ProjectGuid>
    <RootNamespace>GameLogic</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="Common.props" />
  <PropertyGroup>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link>
      <AdditionalOptions>/PDBALTPATH:$(TargetName).pdb %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <!-- BEGIN FILES (tools\gen_project_files.ps1 が再生成する。手編集しない) -->
  <ItemGroup>
    <ClCompile Include="..\src\GameLogic\GameLogicMain.cpp" />
    <ClCompile Include="..\src\GameLogic\Scripts\AudioDemo.cpp" />
    <ClCompile Include="..\src\GameLogic\Scripts\PartAttachDemo.cpp" />
    <ClCompile Include="..\src\GameLogic\Scripts\PartRaycastDemo.cpp" />
    <ClCompile Include="..\src\GameLogic\Scripts\PlayerController.cpp" />
    <ClCompile Include="..\src\GameLogic\Scripts\Rotator.cpp" />
    <ClCompile Include="..\src\GameLogic\Scripts\Spawner.cpp" />
    <ClCompile Include="..\src\GameLogic\Scripts\UIButtonDemo.cpp" />
    <ClCompile Include="..\src\GameLogic\Scripts\WalkerDemo.cpp" />
    <ClInclude Include="..\src\Shared\EngineAPI.h" />
    <ClInclude Include="..\src\Shared\MathPod.h" />
    <ClInclude Include="..\src\Shared\ScriptAPI.h" />
    <ClInclude Include="..\src\Shared\ScriptTypes.h" />
  </ItemGroup>
  <!-- END FILES -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
