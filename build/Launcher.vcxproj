<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{E5F6A7B8-6666-4E9F-B021-3C4D5E6F7081}</ProjectGuid>
    <RootNamespace>Launcher</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="Common.props" />
  <!--
    配布版の Launcher (M98b、ADR-037)。Release の asset として単体で配る exe なので、
    exe 1 個で起動できること (CRT は Common.props の /MT で静的)。
    Engine.lib を丸ごとリンクするが、使うのは窓・D3D11・ImGui・Update だけ。
    それ以外の DLL (音声・コントローラ・C# ホスト・シェーダコンパイラ) は遅延ロードにして、
    呼ばない限り読み込まない (Server.vcxproj と同じ手)。オンライン SDK は Common.props が渡すが、
    Launcher はオンラインのサービスを作らないので import は入らない (dumpbin /dependents で確認済み)
  -->
  <PropertyGroup>
    <TargetName>MyEngineLauncher</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>d3d11.lib;dxgi.lib;d3dcompiler.lib;dxguid.lib;winmm.lib;delayimp.lib;$(RepoRoot)external\nethost\nethost.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <DelayLoadDLLs>d3dcompiler_47.dll;xaudio2_9.dll;Xinput9_1_0.dll;nethost.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
      <!-- LNK4199: import の無い DLL への DELAYLOAD 指定は警告になる (Server.vcxproj と同じ理由で残す) -->
      <AdditionalOptions>/IGNORE:4199 %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <!-- exe とウィンドウのアイコン (M98c)。絵は tools\gen_app_icon.ps1 が生成するメビウスの輪 -->
  <ItemGroup>
    <ResourceCompile Include="res\AppIcon.rc" />
  </ItemGroup>
  <!-- BEGIN FILES (tools\gen_project_files.ps1 が再生成する。手編集しない) -->
  <ItemGroup>
    <ClCompile Include="..\src\Launcher\InstallService.cpp" />
    <ClCompile Include="..\src\Launcher\LauncherMain.cpp" />
    <ClCompile Include="..\src\Launcher\LauncherSelf.cpp" />
    <ClCompile Include="..\src\Launcher\LauncherSelfTest.cpp" />
    <ClCompile Include="..\src\Launcher\LauncherUi.cpp" />
    <ClInclude Include="..\src\Launcher\InstallService.h" />
    <ClInclude Include="..\src\Launcher\LauncherSelf.h" />
    <ClInclude Include="..\src\Launcher\LauncherSelfTest.h" />
    <ClInclude Include="..\src\Launcher\LauncherUi.h" />
  </ItemGroup>
  <!-- END FILES -->
  <ItemGroup>
    <ProjectReference Include="Engine.vcxproj">
      <Project>{8F2D5C31-1A2B-4E3F-9C4D-5E6F7A8B9C0D}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
