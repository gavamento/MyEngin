  <!--
    ヘッドレス専用サーバ (M81)。Engine.lib を丸ごとリンクするので GPU / 音声 / コントローラの import は残るが、
    すべて遅延ロードにする = それらの関数を呼ばない限り DLL はロードされない。
    実行後に GetModuleHandleW で「ロードされていないこと」を Server.exe 自身が検査する (ServerMain.cpp)。
    nethost は ManagedHost::Init (C# ホストの起動) だけが呼ぶ。サーバは C# レーンを持たないので同様に遅延
  -->
  <!--
    AWS GameLift Server SDK 5.x (M81g)。GameLift の依存はこのプロジェクトだけに閉じる (check_rules 規則 13-c)。
    ★SDK は external\gamelift-server-sdk\lib\<構成>\ の静的ライブラリ。Debug = /MTd、Release = /MT で
      ビルドしてあり、Engine.lib と CRT が一致する (手順と取得元は external\gamelift-server-sdk\BUILD.md)。
    ★GAMELIFT_USE_STD は SDK 公開クラスのレイアウトを変える。ライブラリのビルドと必ず同じ値にする。
    ★OpenSSL 3 は DLL でしかリンクできない。import lib をリンクし、ビルド後に DLL を出力先へ置く。
    ★SDK の公開ヘッダは外部インクルード扱いにして警告を止める (第三者コード。警告 0 の機械化の対象外)。
    ★SDK のヘッダは古い MSVC 流儀の WIN32 マクロで Windows を判定する (_WIN32 ではない)。定義しないと
      gmtime_r (POSIX) を引いてコンパイルできない。ライブラリのビルドも /DWIN32 で揃えてある。
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>GAMELIFT_USE_STD=1;WIN32;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <AdditionalOptions>/external:I "$(RepoRoot)external\gamelift-server-sdk\include" /external:I "$(RepoRoot)external\openssl\include" %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(RepoRoot)external\gamelift-server-sdk\lib\$(Configuration)\aws-cpp-sdk-gamelift-server.lib;$(RepoRoot)external\openssl\lib\libssl.lib;$(RepoRoot)external\openssl\lib\libcrypto.lib;ws2_32.lib;crypt32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>xcopy /Y /D /Q "$(RepoRoot)external\openssl\redist\*.dll" "$(OutDir)" &gt; nul</Command>
      <Message>copy OpenSSL DLLs (GameLift Server SDK dependency)</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>d3d11.lib;dxgi.lib;d3dcompiler.lib;dxguid.lib;winmm.lib;delayimp.lib;$(RepoRoot)external\nethost\nethost.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <DelayLoadDLLs>d3d11.dll;dxgi.dll;d3dcompiler_47.dll;xaudio2_9.dll;Xinput9_1_0.dll;nethost.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
      <!-- LNK4199: 実際に import が無い DLL (リンカが未参照の GPU 系オブジェクトを引かなかった) への
           DELAYLOAD は警告になる。Engine.lib の将来の変更で import が増えても遅延になるよう指定は残す -->
      <AdditionalOptions>/IGNORE:4199 %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
