<?xml version="1.0" encoding="utf-8"?>
<!--
  全プロジェクト共通のビルド設定。
  Debug/Release 一貫性ポリシー (engine_spec.md 11 章) に関わる設定はここで一元管理する:
    - /fp:precise を全構成で強制 (/fp:fast 禁止)
    - /arch は全構成で同一 (既定 = SSE2)
    - /Zi 固定 (/ZI Edit&Continue は GameLogic.dll ホットリロードと衝突するため禁止)
    - RuntimeLibrary は構成内で全プロジェクト一致 (_ITERATOR_DEBUG_LEVEL / CRT ヒープ不一致防止)
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
    <OutDir>$(RepoRoot)bin\x64\$(Configuration)\</OutDir>
    <IntDir>$(RepoRoot)obj\$(ProjectName)\x64\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <ConformanceMode>true</ConformanceMode>
      <FloatingPointModel>Precise</FloatingPointModel>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!--
        警告 0 の機械化 (M52b)。**既定 off** — ローカル開発が警告 1 個で止まらないように。
        CI だけ /p:MyeWarnAsError=true で有効にする (tools\replay_verify.bat が
        MYE_MSBUILD_ARGS 経由で受け取る)。
        ★ C++ の TreatWarningAsError は ClCompile の**項目メタデータ**なので、
          MSBuild のグローバルプロパティ /p:TreatWarningAsError=true では効かない
          (プロパティは設定されるが誰も読まない = 静かに素通り)。ここで明示的に橋渡しする。
        external\ の第三者コードは Engine.vcxproj 側で個別に false へ落としてある。
      -->
      <TreatWarningAsError Condition="'$(MyeWarnAsError)'=='true'">true</TreatWarningAsError>
      <AdditionalOptions>/utf-8 /Zc:preprocessor %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>NOMINMAX;WIN32_LEAN_AND_MEAN;_CRT_SECURE_NO_WARNINGS;IMGUI_DISABLE_OBSOLETE_FUNCTIONS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(RepoRoot)src;$(RepoRoot)external;$(RepoRoot)external\imgui;$(RepoRoot)obj\generated\$(Configuration);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <!--
    ビルド情報の埋め込み (M52f)。クラッシュ報告に「どのコミットの・どの構成のビルドか」が
    無いと、届いた minidump の RVA を突き合わせる相手 (pdb) を特定できない = 報告が死ぬ。
    ★ClCompile の PreprocessorDefinitions へ直接書かない。git ハッシュはコミットの度に
      変わるので、定義値が変われば全 .cpp のコマンドラインが変わり毎回フルリビルドになる。
      生成ヘッダに逃がして、包含している 1 ファイル (CrashHandler.cpp) だけが焼き直る形にする。
    ★書き手は Engine プロジェクトだけ。/m の並列ビルドで 4 プロジェクトが同じファイルを
      書くと競る (WriteOnlyWhenDifferent でも読みが割れうる)。Editor/Runtime は Engine.lib
      経由で文字列を受け取るので生成は要らない。
    ★出力は構成ごとに分ける — Debug と Release で MYE_BUILD_CONFIG が違うため。
    git が無い / リポジトリ外へ展開された場合は "unknown" に落とす (ビルドは止めない)。
  -->
  <Target Name="MyeBuildInfo" BeforeTargets="ClCompile" Condition="'$(MSBuildProjectName)'=='Engine'">
    <!-- exclude=* でタグ名を使わせず、always で短縮ハッシュ、dirty で未コミット差分を明示 -->
    <Exec Command="git -C &quot;$(RepoRoot).&quot; describe --always --dirty --abbrev=12 --exclude=*"
          ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="MyeGitRaw" />
    </Exec>
    <PropertyGroup>
      <!-- git のエラー文が混ざりうるので、形が合ったときだけ採用する -->
      <MyeGitHash>unknown</MyeGitHash>
      <MyeGitHash Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(MyeGitRaw)', '^[0-9a-f]{7,40}(-dirty)?$'))">$(MyeGitRaw)</MyeGitHash>
    </PropertyGroup>
    <WriteLinesToFile File="$(RepoRoot)obj\generated\$(Configuration)\MyeBuildInfo.h"
                      Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="#pragma once;// build\Common.props の MyeBuildInfo ターゲットが生成する。手で編集しない;#define MYE_GIT_HASH &quot;$(MyeGitHash)&quot;;#define MYE_BUILD_CONFIG &quot;$(Configuration)&quot;" />
  </Target>
</Project>
